#compdef sl
# zsh completion for sl -- generated by tools/completions, do not edit
#
# Install: /usr/share/zsh/vendor-completions/_sl on Debian/Ubuntu,
#          /usr/share/zsh/site-functions/_sl elsewhere (both in $fpath),
#          then run compinit (or open a new shell).

_sl_groups() {
    # the value of --rule is "RE -> GROUP"; offer GROUP once the arrow is typed
    local cur=${(Q)PREFIX}
    local -a cand
    if [[ $cur == *'-> '* || $cur == *'->' ]]; then
        local head=${cur%->*}
        local g
        for g in special dir build app dev A2 WWW aux doc book document image vector audio video font data other archive dotfile Mac file ignore; do
            cand+=( "${head}-> ${g}" )
        done
        compadd -a cand
    fi
}

_sl() {
    local -a args
    args=(
        '--age+[alias for --atime (the name used on the original site)]:N: '
        '(--all -a)'{--all,-a}'[show dotfiles and normally ignored files (ignore level 0)]'
        '--annotate+[run a shell command per entry and show its output (see --help)]:CMD:_command_names -e'
        '--annotate-batch+[run CMD once per directory; it gets the paths on stdin, one output line per path]:CMD:_command_names -e'
        '--annotate-match+[only annotate entries whose name matches RE]:RE: '
        '--atime+[also mark files read in the last N seconds (alias --age)]:N: '
        '--autosearch+[highlight names matching RE (default\: urgent|password|pw|live)]:RE: '
        '(--color -c)'{--color,-c}'=-[colour\: auto (default), always, never; a bare -c/--color means always]::WHEN:(auto always never)'
        '--colsep+[minimal gap between columns (default 1)]:N: '
        '--config+[read configuration from FILE, which must exist (default\: $XDG_CONFIG_HOME/sl/config, created on first run)]:FILE:_files'
        '--ellipsis+[text used when a name is shortened (default "...")]:S: '
        '--expando+[auto-expand a directory with at most N files (0 = off)]:N: '
        '--experimental[alias for --group-mix plus --owner-notes (the original'\''s TAP branch)]'
        '--group[group by kind (default on)]'
        '--group-mix[print "5+3" instead of "8" on a directory classified by its contents]'
        '(--help -h)'{--help,-h}'[print this help and exit]'
        '--ignore+[ignore level to show\: 3 default, 2 +.h/.o, 1 +dotfiles, 0 all]:N:(0 1 2 3)'
        '--inline-singleton[show "src/main.c" instead of "src/1" for a directory holding one entry]'
        '--k1000[use 1000, not 1024, as the size divisor (--k1000=off puts it back)]'
        '--k1024[use 1024 as the size divisor (default)]'
        '--legacy-classify[Tcl rule\: an entry with no suffix inside a directory counts as a subdirectory]'
        '--legacy-series[Tcl rule\: names that differ in any one digit or letter count as a series]'
        '(--log -l)'{--log,-l}'[print layout diagnostics]'
        '--mounts+[mount points that may spin up (colon separated)]:LIST:_files'
        '--namemin+[width that still allows two columns (default 40)]:N: '
        '--no-color[never use colors]'
        '--no-config[do not read (or create) any configuration file]'
        '--no-notable[do not highlight README/TODO/Makefile/...]'
        '--no-owner-notes[do not annotate files owned by other users]'
        '--nogroup[one flat sorted list, no group titles]'
        '--nosfx[with --title, drop the suffix for audio/video/image/font]'
        '--notable[highlight README/TODO/Makefile/... (default on)]'
        '(--one -1)'{--one,-1}'[one entry per line (--one=off turns it back)]'
        '(--only -o)'{--only,-o}'[show only entries that carry some signal]'
        '--owner-notes[in the home directory, name the owner of files that are not yours (default on)]'
        '--prefix+[elide a shared prefix of at least N chars (0 = off)]:N: '
        '--relchange+[percent of entries called "relatively recent" (0 = off)]:N: '
        '--relread+[percent of entries called "relatively read" (0 = off)]:N: '
        '--relsize+[percent of entries called "relatively large" (0 = off)]:N: '
        '--rule+[force a group when the name matches RE; repeatable, first match wins]:RE -> GROUP:_sl_groups'
        '--series+[collapse runs of at least N numbered names (default 5)]:N: '
        '--shorten+[start shortening names when there are at least N entries]:N: '
        '--startup+[(ignored) the Tcl startup file; use --config instead]:FILE:_files'
        '--summary+[print the summary line from N entries on (0 = never)]:N: '
        '(--title -t)'{--title,-t}'[prettify names (camelCase -> words, separators -> space)]'
        '(--version -V)'{--version,-V}'[print the version and exit]'
        '(--width -w)'{--width,-w}'+[assume a terminal N columns wide]:N: '
        '*:file:_files'
    )
    _arguments -s -S "${args[@]}"
}

_sl "$@"
